						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGc1/4xV+JVL0U=",
							"_parent": {
								"$ref": "AAAAAAGcxEFp6319uqA="
							},
							"font": "Arial;15;0",
							"left": 80,
							"top": 464,
							"width": 384,
							"height": 445,
							"text": "Var \n   fig: Figure\n     fig<--new Triangle()\n     fig<--new Carre()\n\nMere -->Fille (Figure ---> Carre ou Triangle)\n\n   objetFille =(Fille)ObjetMere\nVar \n     fig: Figure\n     fig<--new Triangle()\n     fig.getCote()\n     fig.getHauteur() //Erreur\n     tra:Triangle\n     tra<---(Triangle) fig\n     tran.getHauteur()\n\nVar \n   fig:Figure\n   fig<--new Carre()\n     fig.surface()\n     fig.perimetre()\n     fig.getCote()\n   fig<--new Triangle()\n      fig.surface()\n     fig.perimetre()\n     fig.getCote()\n    \n\n"
						}
					]
				},
