							"top": 56,
							"width": 289,
							"height": 177,
							"text": "Type valeurs. \nentier,reell,chaine,booleen,caractere,structure\n\nx:entier\n x<--1     ecrire(x) //1\ny:reel\ny<--12.5\necrire(y) //12.5\n//Tableau est type de Reference\ntype tEntier=tableau[1..3]entier\nt:TEntier\nt[1]<--12"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGcLnn6cuXsqmg=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"font": "Arial;13;0",
							"left": 1032,
							"top": 32,
							"width": 320,
							"height": 281,
							"text": "Types de Reference\n Objet\n //1-Declaration \n    cl3, cl2,cl1:Client \n//2-Intanciation\n  cl1<--new Client()\n  Ecrire(cl1) //4F2\n\n  cl2<--cl1//Copie de Reference\n               //Cloner un Objet(copie de Valeur)\nOperateur de portee sur Objet(-->,.)\n Ecrire(cl1.nomComplet ) //Erreur\n Ecrire(cl1.anNaiiss ) //2008\n\nEcrire(cl2.nomComplet ) //Erreur\n Ecrire(cl2.anNaiiss ) //2008\ncl2.anNaiiss<--2017\n\nEcrire(cl1.anNaiiss ) //2017\n"
						},
